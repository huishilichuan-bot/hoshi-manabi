rules_version = '2';
// ほしまなび — Firestore セキュリティルール
// users/{userId} は、ログインした本人（request.auth.uid == userId）だけが読み書きできる。それ以外はすべて拒否。
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'v'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 800000
        && request.resource.data.updatedAt is int
        && request.resource.data.v is int;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
